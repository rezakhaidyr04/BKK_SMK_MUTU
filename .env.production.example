APP_NAME="BKKMu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bkk_smk_mutu
DB_USERNAME=
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=.domain.com (jika dipakai di subdomain)

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="bkk@smkmutu.sch.id"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=bkk-smk-mutu-storage
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# A/B Testing
AB_TESTING_ENABLED=true
AB_ASSIGNMENT_STRATEGY=session

# G1: Login Google — redirect URI terdaftar: https://domain/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="https://domain/auth/google/callback"

# Reverse proxy / tunnel (kosong = tolak semua proxy; isi IP load balancer bila ada)
TRUSTED_PROXIES=
# Domain SPA yang boleh pakai cookie Sanctum (kosongkan bila tidak pakai SPA)
SANCTUM_STATEFUL_DOMAINS=

# Checklist deploy production:
# 1. cp .env.production.example .env lalu isi APP_KEY via: php artisan key:generate --force
# 2. php artisan migrate --force
# 3. php artisan storage:link
# 4. php artisan config:cache && php artisan route:cache && php artisan view:cache
# 5. Jalankan queue worker (systemd/supervisor): php artisan queue:work --tries=3
# 6. Cron scheduler: * * * * * php /path/artisan schedule:run >> /dev/null 2>&1
# 7. Pastikan HTTPS aktif (SESSION_SECURE_COOKIE=true butuh HTTPS)
